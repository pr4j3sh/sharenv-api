DEBUG=False
DATABASE=sharenv
MONGO_URI=mongodb://mongo:27017

# API docs (/docs, /redoc, /openapi.json) are disabled unless this is True
DOCS_ENABLED=False

# openssl rand -hex 32 (at least 32 bytes)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY=15

# Refresh tokens are single-use and rotated on POST /v1/auth/refresh
REFRESH_TOKEN_EXPIRY_DAYS=30

# Auth rate limiting (per-IP requests/min across /v1/auth/*; failed logins
# per email before lockout; wrong OTP guesses and resends per user)
AUTH_RATE_LIMIT_PER_IP=30
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
OTP_VERIFY_ATTEMPTS=10
OTP_RESEND_LIMIT=3

# Master keys never go into this file: they live in
# deploy/secrets/encryption_keys.json (see docs/self-hosting.md), which Compose
# mounts as a Docker secret at /run/secrets/encryption_keys.
# ENCRYPTION_KEY_VERSION is the active version used for new writes.
ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys
ENCRYPTION_KEY_VERSION=1

# Required unless DEBUG=True (DEBUG skips email delivery and logs the OTP)
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>

# Account verification OTP lifetime (minutes) and length (digits)
OTP_EXPIRY=10
OTP_LENGTH=6
