DEBUG=False
DATABASE=sharenv
MONGO_URI=mongodb://127.0.0.1:27017

# openssl rand -hex 32 (at least 32 bytes)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY=60

# Master key registry: {"<version>": "<base64 key>"} — one entry per key
# version (openssl rand -base64 32; must decode to exactly 32 bytes).
# ENCRYPTION_KEY_VERSION is the active version used for new writes.
# Alternatively point ENCRYPTION_KEYS_FILE at a JSON file with the same shape
# (used for Docker secrets); set only one of the two.
ENCRYPTION_KEYS_JSON={"1": ""}
ENCRYPTION_KEY_VERSION=1

# Required unless DEBUG=True (DEBUG skips email delivery and logs the OTP)
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>

# Account verification OTP lifetime (minutes) and length (digits)
OTP_EXPIRY=10
OTP_LENGTH=6
